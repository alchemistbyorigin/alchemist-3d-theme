<aside
  class="cart-drawer"
  id="CartDrawer"
  hidden
  data-cart-drawer
  data-section-id="{{ section.id }}"
  data-free-shipping-threshold="{{ section.settings.free_shipping_threshold | times: 100 }}"
  aria-labelledby="CartDrawerTitle"
>
  <div class="cart-drawer__backdrop" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="cart-drawer__header">
      <h2 id="CartDrawerTitle">Your cart <span data-cart-count>{{ cart.item_count }}</span></h2>
      <button type="button" aria-label="Close cart" data-cart-close>X</button>
    </div>

    {% if section.settings.enable_free_shipping_bar and section.settings.free_shipping_threshold > 0 %}
      <div class="cart-drawer__shipping" data-shipping-progress>
        {% assign shipping_threshold = section.settings.free_shipping_threshold | times: 100 %}
        {% assign shipping_remaining = shipping_threshold | minus: cart.total_price %}
        {% if shipping_remaining > 0 %}
          <p data-shipping-message>Spend {{ shipping_remaining | money }} more for free shipping.</p>
        {% else %}
          <p data-shipping-message>You unlocked free shipping.</p>
        {% endif %}
        <div class="cart-drawer__progress" role="progressbar" aria-valuemin="0" aria-valuemax="{{ shipping_threshold }}" aria-valuenow="{{ cart.total_price }}" data-shipping-progressbar>
          <span data-shipping-bar style="width: {{ cart.total_price | times: 100.0 | divided_by: shipping_threshold | at_most: 100 }}%;"></span>
        </div>
      </div>
    {% endif %}

    <p class="cart-error" data-cart-error role="alert" hidden></p>
    <div class="cart-drawer__content" data-cart-content>
      {% if cart.item_count == 0 %}
        <div class="cart-drawer__empty">
          <p>Your cart is empty.</p>
          <a class="cart-drawer__continue" href="{{ routes.all_products_collection_url }}">Explore the collection</a>
        </div>
      {% else %}
        <div class="cart-drawer__items" data-cart-items>
          {% for item in cart.items %}
            <article class="cart-item" data-cart-item data-key="{{ item.key | escape }}">
              {% if item.image %}
                {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '96px', alt: item.product.title }}
              {% endif %}
              <div class="cart-item__details">
                <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
                {% unless item.properties == empty %}
                  <ul class="cart-item__properties" role="list">
                    {% for property in item.properties %}
                      {% assign property_first_char = property.first | slice: 0 %}
                      {% unless property.last == blank or property_first_char == '_' %}
                        <li>{{ property.first | escape }}: {{ property.last | escape }}</li>
                      {% endunless %}
                    {% endfor %}
                  </ul>
                {% endunless %}
                <div class="cart-item__pricing">
                  {% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}
                  <strong>{{ item.final_line_price | money }}</strong>
                  {% if item.unit_price_measurement %}<small>{{ item.unit_price | money }} / {{ item.unit_price_measurement.reference_unit }}</small>{% endif %}
                </div>
                <div class="cart-item__quantity">
                  <label class="visually-hidden" for="CartQuantity-{{ section.id }}-{{ forloop.index }}">Quantity for {{ item.product.title | escape }}</label>
                  <button type="button" aria-label="Decrease quantity" data-quantity-decrease>-</button>
                  <input id="CartQuantity-{{ section.id }}-{{ forloop.index }}" type="number" min="0" value="{{ item.quantity }}" inputmode="numeric" data-cart-quantity>
                  <button type="button" aria-label="Increase quantity" data-quantity-increase>+</button>
                </div>
                <button type="button" data-cart-remove>Remove</button>
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <form class="cart-drawer__footer" action="{{ routes.cart_url }}" method="post" data-cart-form>
        {% if cart.cart_level_discount_applications.size > 0 %}
          <ul class="cart-drawer__discounts" role="list">
            {% for discount in cart.cart_level_discount_applications %}
              <li>{{ discount.title | escape }}: -{{ discount.total_allocated_amount | money }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if section.settings.show_cart_note %}
          <details class="cart-drawer__note">
            <summary>Add an order note</summary>
            <label for="CartDrawerNote-{{ section.id }}">Order note</label>
            <textarea id="CartDrawerNote-{{ section.id }}" name="note" rows="3">{{ cart.note | escape }}</textarea>
          </details>
        {% endif %}
        <p class="cart-drawer__shipping-note">Shipping and taxes calculated at checkout.</p>
        <div class="cart-drawer__total"><span>Subtotal</span><strong data-cart-subtotal>{{ cart.total_price | money }}</strong></div>
        <button class="cart-drawer__checkout" type="submit" name="checkout">Checkout</button>
        <a href="{{ routes.cart_url }}">View cart</a>
      </form>
    {% endif %}
  </div>
</aside>



{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_free_shipping_bar",
      "label": "Enable free shipping progress bar",
      "default": false
    },
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "min": 0,
      "max": 500,
      "step": 5,
      "info": "Amount in your store currency. Match your shipping settings.",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "Show order note",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Cart drawer"
    }
  ]
}
{% endschema %}
