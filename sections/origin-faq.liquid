{% if section.blocks.size > 0 %}<section class="section-wrap faq-section"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div>{% for block in section.blocks %}<details class="accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>{% endif %}
{% schema %}
{
  "name": "Questions and answers",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A LITTLE MORE CLARITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good questions."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How can I contact you?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Visit our contact page to get in touch with our team.</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Questions and answers"
    }
  ]
}
{% endschema %}
