/* ==========================================================================
   ALCHEMIST 3D HERO SECTION
   ========================================================================== */

/* 1. Base Container */
.section-alchemist-hero {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 650px;
  background-color: #0d0d11;
  color: #f3f3f5;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.alchemist-hero {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 2. Three.js Canvas & Fallback Layer */
.alchemist-hero__canvas,
.alchemist-hero__fallback {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.alchemist-hero__canvas canvas {
  width: 100% !important;
  height: 100% !important;
  display: block;
}

.alchemist-hero__fallback-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* 3. Dark Luxury Overlay */
.alchemist-hero__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(
    circle at center,
    rgba(13, 13, 17, 0.3) 0%,
    rgba(13, 13, 17, 0.85) 100%
  );
  z-index: 2;
  pointer-events: none;
}

/* 4. Content Block */
.alchemist-hero__content {
  position: relative;
  z-index: 3;
  max-width: 900px;
  padding: 0 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

/* Eyebrow */
.alchemist-hero__eyebrow {
  font-family: 'Cinzel', 'Cormorant Garamond', Georgia, serif;
  font-size: 0.875rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: #d4af37;
  margin: 0;
}

/* Heading */
.alchemist-hero__heading,
.alchemist-hero__heading p {
  font-family: 'Cinzel', 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 400;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #f3f3f5;
  margin: 0;
  line-height: 1.1;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
}

/* Subheading */
.alchemist-hero__subheading,
.alchemist-hero__subheading p {
  font-size: clamp(1rem, 1.8vw, 1.25rem);
  font-weight: 300;
  letter-spacing: 0.05em;
  color: #a0a0b0;
  margin: 0;
  max-width: 600px;
  line-height: 1.6;
}

/* 5. Buttons */
.alchemist-hero__actions {
  display: flex;
  gap: 20px;
  margin-top: 16px;
  flex-wrap: wrap;
  justify-content: center;
}

.alchemist-hero__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 36px;
  font-family: 'Cinzel', 'Cormorant Garamond', Georgia, serif;
  font-size: 0.875rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  cursor: pointer;
}

.alchemist-hero__button--primary {
  background-color: transparent;
  color: #d4af37;
  border: 1px solid #d4af37;
}

.alchemist-hero__button--primary:hover {
  background-color: #d4af37;
  color: #0d0d11;
  box-shadow: 0 0 20px rgba(212, 175, 55, 0.35);
}

.alchemist-hero__button--secondary {
  background-color: transparent;
  color: #f3f3f5;
  border: 1px solid rgba(243, 243, 245, 0.3);
}

.alchemist-hero__button--secondary:hover {
  border-color: #f3f3f5;
  color: #f3f3f5;
  background-color: rgba(243, 243, 245, 0.05);
}

/* 6. Scroll Indicator */
.alchemist-hero__scroll {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  color: #a0a0b0;
}

.alchemist-hero__scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, #d4af37, transparent);
  animation: alchemistScrollPulse 2s infinite ease-in-out;
}

@keyframes alchemistScrollPulse {
  0% {
    transform: scaleY(0);
    transform-origin: top;
  }
  50% {
    transform: scaleY(1);
    transform-origin: top;
  }
  50.1% {
    transform: scaleY(1);
    transform-origin: bottom;
  }
  100% {
    transform: scaleY(0);
    transform-origin: bottom;
  }
}

/* 7. Mobile Responsive */
@media (max-width: 768px) {
  .section-alchemist-hero {
    min-height: 550px;
  }

  .alchemist-hero__actions {
    flex-direction: column;
    width: 100%;
    max-width: 280px;
  }

  .alchemist-hero__button {
    width: 100%;
  }
}