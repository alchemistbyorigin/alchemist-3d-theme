<section class="origin-hero" data-hero-3d data-section-id="{{ section.id }}" aria-labelledby="HeroTitle-{{ section.id }}">
<div class="origin-hero__art">
{% if section.settings.fallback_image != blank %}
{{ section.settings.fallback_image | image_url: width: 2000 | image_tag: widths: '640, 960, 1440, 2000', sizes: '(min-width: 900px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'origin-hero__image' }}
{% else %}<img src="{{ 'origin-editorial.webp' | asset_url }}" width="1536" height="1024" alt="Sculptural silver and gold forms on stone plinths" class="origin-hero__image" fetchpriority="high">{% endif %}
{% if section.settings.enable_3d %}<div class="origin-hero__canvas" data-three-container aria-hidden="true"></div>{% endif %}
</div>
<div class="origin-hero__copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 id="HeroTitle-{{ section.id }}">{{ section.settings.heading | strip_html | escape }}</h1><div class="origin-hero__description">{{ section.settings.subheading }}</div>
<div class="button-row"><a class="button button--light" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_text | escape }} <span aria-hidden="true">â†—</span></a>
{% if section.settings.secondary_link != blank %}<a class="text-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_text | escape }}</a>{% endif %}</div>
<p class="origin-hero__index"><span>01 /</span> {{ section.settings.caption | escape }}</p></div>
<script type="application/json" data-hero-settings>{"enabled":{{ section.settings.enable_3d | json }},"rotationSpeed":{{ section.settings.rotation_speed | json }},"mobileQuality":{{ section.settings.mobile_quality | json }}}</script>
</section>
{% schema %}
{
  "name": "Sculptural hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FORM. FEELING. ORIGIN."
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Objects with presence.</p>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>A considered collection of sculptural forms. Discover a new perspective on the everyday.</p>"
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "Primary button",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary button",
      "default": "Our philosophy"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "A study in material and form"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Campaign image"
    },
    {
      "type": "checkbox",
      "id": "enable_3d",
      "label": "Enable interactive sculpture",
      "default": false,
      "info": "Optional decorative 3D. The campaign image remains visible when motion is reduced."
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Rotation speed",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 0.4
    },
    {
      "type": "select",
      "id": "mobile_quality",
      "label": "Mobile quality",
      "options": [
        {
          "value": "low",
          "label": "Low"
        },
        {
          "value": "medium",
          "label": "Medium"
        }
      ],
      "default": "low"
    }
  ],
  "presets": [
    {
      "name": "Sculptural hero"
    }
  ]
}
{% endschema %}
