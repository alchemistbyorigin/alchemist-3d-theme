{% assign selected_collection = section.settings.collection | default: collections.all %}
<section class="section-wrap featured-products" aria-labelledby="FeaturedTitle-{{ section.id }}"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="FeaturedTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ selected_collection.url | default: routes.all_products_collection_url }}">View collection <span aria-hidden="true">↗</span></a></div>
<div class="product-grid" style="--columns: {{ section.settings.columns }}">
{% for product in selected_collection.products limit: section.settings.product_limit %}{% render 'product-card', product: product %}{% else %}
{% for i in (1..4) %}<article class="product-card"><div class="product-card__media">{{ 'product-1' | placeholder_svg_tag }}</div><h3>Product title</h3><p>{{ 10000 | money }}</p></article>{% endfor %}
{% endfor %}</div></section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE CONSIDERED EDIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A study in form."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "All products are shown until you choose a collection."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
