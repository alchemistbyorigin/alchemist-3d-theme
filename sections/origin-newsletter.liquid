<section class="newsletter-section"><div class="section-wrap newsletter-layout"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div>{% assign newsletter_id = 'Newsletter-' | append: section.id %}{% form 'customer', id: newsletter_id %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="Email-{{ section.id }}">Email address</label><div class="newsletter-input"><input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="Your email address"><button type="submit" aria-label="Subscribe to newsletter">↗</button></div>{% if form.posted_successfully? %}<p role="status">You're on the list. Thank you.</p>{% endif %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}<p class="fine-print">{{ section.settings.consent | escape }}</p>{% endform %}</div></section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LET US KEEP YOU CLOSE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The next chapter, first."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "New collections, fresh perspectives and notes from the studio."
    },
    {
      "type": "text",
      "id": "consent",
      "label": "Consent text",
      "default": "Subscribe to receive our emails. Unsubscribe at any time."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
