<section class="section-wrap page-narrow"><p class="eyebrow">LET'S START A CONVERSATION</p><h1>{{ page.title | default: 'Get in touch.' | escape }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p class="form-success" role="status">Thank you. Your message has been sent.</p>{% endif %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}<div><label for="ContactName">Name</label><input id="ContactName" name="contact[name]" type="text" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required></div><div><label for="ContactEmail">Email address</label><input id="ContactEmail" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required></div><div><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea></div><button class="button" type="submit">Send message ↗</button>{% endform %}</section>
{% schema %}
{"name": "Contact", "settings": []}
{% endschema %}
