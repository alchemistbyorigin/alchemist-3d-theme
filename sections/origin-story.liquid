<section class="editorial" id="OriginStory"><div class="editorial__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '640, 960, 1600', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy' }}{% else %}<img src="{{ 'origin-editorial.webp' | asset_url }}" width="1536" height="1024" loading="lazy" alt="A sculptural study of metal and stone">{% endif %}</div><div class="editorial__copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}<span class="editorial__number" aria-hidden="true">02 / ORIGIN</span></div></section>
{% schema %}
{
  "name": "Editorial story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE ORIGIN OF AN OBJECT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Less noise. More meaning."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story",
      "default": "<p>Some things ask for a second look. A curve that catches the light. A texture that invites touch. A form that feels entirely your own.</p><p>Explore the meeting point of material, proportion and personal expression.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Discover our story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Story link"
    }
  ],
  "presets": [
    {
      "name": "Editorial story"
    }
  ]
}
{% endschema %}
