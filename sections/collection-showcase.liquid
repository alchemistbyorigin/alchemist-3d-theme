<section class="alchemist-section alchemist-collections" id="CollectionShowcase-{{ section.id }}">
  <div class="alchemist-section__inner">
    <div class="alchemist-section__header">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="alchemist-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="alchemist-section__title">{{ section.settings.heading | escape }}</h2>{% endif %}
      </div>
    </div>

    <div class="alchemist-collection-grid">
      {% for block in section.blocks %}
        {% liquid
          assign collection_item = block.settings.collection
          assign collection_image = block.settings.image
          if collection_image == blank and collection_item != blank
            assign collection_image = collection_item.featured_image
          endif
        %}
        <article class="alchemist-collection-card" {{ block.shopify_attributes }}>
          <a class="alchemist-collection-card__link" href="{% if collection_item != blank %}{{ collection_item.url }}{% else %}#{% endif %}">
            <div class="alchemist-collection-card__media">
              {% if collection_image != blank %}
                {{ collection_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 900px) 33vw, 100vw', class: 'alchemist-collection-card__image' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'alchemist-collection-card__placeholder' }}
              {% endif %}
              <span class="alchemist-collection-card__shade" aria-hidden="true"></span>
            </div>
            <div class="alchemist-collection-card__content">
              {% if block.settings.eyebrow != blank %}<span class="alchemist-kicker">{{ block.settings.eyebrow | escape }}</span>{% endif %}
              <h3>{{ block.settings.title | default: collection_item.title | default: 'Collection' | escape }}</h3>
              <span class="alchemist-text-link">{{ block.settings.link_label | escape }}</span>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection showcase",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP BY WORLD" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the collection" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 / OBJECTS" },
        { "type": "text", "id": "title", "label": "Custom title" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "EXPLORE" }
      ]
    }
  ],
  "presets": [{ "name": "Collection showcase", "blocks": [{"type":"collection"},{"type":"collection"},{"type":"collection"}] }]
}
{% endschema %}
