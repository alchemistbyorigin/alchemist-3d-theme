{{ 'alchemist.css' | asset_url | stylesheet_tag }}

<div class="hero-3d-wrapper" id="Hero3D-{{ section.id }}">
  <div class="hero-3d-canvas-container">
    <canvas id="hero-3d-canvas-{{ section.id }}"></canvas>
    <div class="hero-3d-vignette"></div>
  </div>

  <div class="hero-3d-content">
    {% if section.settings.badge != blank %}
      <span class="hero-3d-badge">{{ section.settings.badge | escape }}</span>
    {% endif %}

    <h1 class="hero-3d-title">{{ section.settings.heading | escape }}</h1>
    <p class="hero-3d-subheading">{{ section.settings.subheading | escape }}</p>

    <div class="hero-3d-actions">
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="hero-3d-btn primary">
          <span>{{ section.settings.button_label | escape }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {% endif %}
      {% if section.settings.secondary_button_label != blank %}
        <a href="{{ section.settings.secondary_button_link }}" class="hero-3d-btn secondary">
          {{ section.settings.secondary_button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" defer></script>
<script src="{{ 'three-hero.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Futuristic 3D Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "SYSTEM v2.0 // ALCHEMIST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE FUTURE OF DIGITAL MATTER"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered with WebGL precision and next-gen material aesthetics."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "EXPLORE CORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "DOCUMENTATION"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Futuristic 3D Hero"
    }
  ]
}
{% endschema %}