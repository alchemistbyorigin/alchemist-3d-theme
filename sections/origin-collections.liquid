{% assign has_collections = false %}{% for block in section.blocks %}{% if block.settings.collection != blank %}{% assign has_collections = true %}{% endif %}{% endfor %}
{% if has_collections or request.design_mode %}<section class="section-wrap"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="collection-tiles">
{% for block in section.blocks %}{% assign tile_collection = block.settings.collection %}{% assign tile_image = block.settings.image | default: tile_collection.featured_image %}{% if tile_collection != blank %}<a class="collection-tile" href="{{ tile_collection.url }}" {{ block.shopify_attributes }}>{% if tile_image %}{{ tile_image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 750px) 33vw, 90vw', loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}<span>{{ block.settings.title | default: tile_collection.title | escape }} <span aria-hidden="true">â†—</span></span></a>{% elsif request.design_mode %}<div class="collection-tile" {{ block.shopify_attributes }}>{{ 'collection-1' | placeholder_svg_tag }}<span>Choose a collection</span></div>{% endif %}{% endfor %}</div></section>
{% endif %}
{% schema %}
{
  "name": "Collection gallery",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FIND YOUR EXPRESSION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Different forms. One point of view."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Collection gallery",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
