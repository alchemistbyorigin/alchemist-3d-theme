<section class="section-wrap"><p class="eyebrow">FIND SOMETHING MEANINGFUL</p><h1>Explore.</h1><form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label for="SearchInput-{{ section.id }}" class="visually-hidden">Search the store</label><input id="SearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, stories and more" required><button class="button" type="submit">Search</button></form>{% if search.performed %}<p class="search-count">{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% paginate search.results by 24 %}<div class="product-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% else %}<article><p class="eyebrow">{{ result.object_type | escape }}</p><h3><a href="{{ result.url }}">{{ result.title | escape }}</a></h3><p>{{ result.content | strip_html | truncate: 120 }}</p></article>{% endif %}{% else %}<div class="empty-state"><h2>No results yet.</h2><p>Try a different name or a broader search.</p></div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}{% endif %}</section>
{% schema %}
{"name": "Search", "settings": []}
{% endschema %}
