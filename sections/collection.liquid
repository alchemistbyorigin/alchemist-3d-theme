{% liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign products_per_page = section.settings.products_per_page | default: 24
%}

<section class="collection-page" data-collection-section>
  <header class="collection-page__header">
    <div class="collection-page__heading">
      <p class="collection-page__eyebrow">{{ 'collections.collection.eyebrow' | t }}</p>
      <h1>{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <div class="collection-page__description rte">{{ collection.description }}</div>
      {% endif %}
    </div>

    {% if section.settings.show_collection_image and collection.featured_image != blank %}
      <div class="collection-page__image">
        {{
          collection.featured_image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 990px) 40vw, 100vw',
            alt: collection.featured_image.alt | default: collection.title | escape
        }}
      </div>
    {% endif %}
  </header>

  {% paginate collection.products by products_per_page %}
    <div class="collection-page__toolbar">
      <p class="collection-page__count" aria-live="polite">
        {{ 'collections.collection.product_count' | t: count: collection.products_count }}
      </p>

      <details class="collection-page__filters-drawer">
        <summary class="collection-page__filter-toggle">
          <span>{{ 'collections.collection.filter' | t }}</span>
          {% assign active_filter_count = 0 %}
          {% for filter in collection.filters %}
            {% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}
            {% if filter.type == 'price_range' and filter.min_value.value != nil or filter.type == 'price_range' and filter.max_value.value != nil %}
              {% assign active_filter_count = active_filter_count | plus: 1 %}
            {% endif %}
          {% endfor %}
          {% if active_filter_count > 0 %}<span class="collection-page__filter-count">{{ active_filter_count }}</span>{% endif %}
        </summary>

        <form class="collection-page__filter-form" action="{{ collection.url }}" method="get">
          <input type="hidden" name="sort_by" value="{{ current_sort | escape }}">

          {% for filter in collection.filters %}
            <details class="collection-page__filter-group" open>
              <summary>
                <span>{{ filter.label | escape }}</span>
                {% if filter.active_values.size > 0 %}<span>{{ filter.active_values.size }}</span>{% endif %}
              </summary>

              <div class="collection-page__filter-values">
                {% case filter.type %}
                  {% when 'boolean', 'list' %}
                    {% for value in filter.values %}
                      <label class="collection-page__filter-value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        <span>{{ value.label | escape }}</span>
                        <small>{{ value.count }}</small>
                      </label>
                    {% endfor %}

                  {% when 'price_range' %}
                    <div class="collection-page__price-range">
                      <label>
                        <span>{{ 'collections.collection.price_from' | t }}</span>
                        <span class="collection-page__money-input">
                          <span>{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            inputmode="decimal"
                          >
                        </span>
                      </label>
                      <label>
                        <span>{{ 'collections.collection.price_to' | t }}</span>
                        <span class="collection-page__money-input">
                          <span>{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            inputmode="decimal"
                          >
                        </span>
                      </label>
                    </div>
                {% endcase %}
              </div>
            </details>
          {% endfor %}

          <div class="collection-page__filter-actions">
            <button type="submit" class="alchemist-button">{{ 'collections.collection.apply' | t }}</button>
            <a href="{{ collection.url }}?sort_by={{ current_sort | url_encode }}" class="alchemist-text-link">{{ 'collections.collection.clear' | t }}</a>
          </div>
        </form>
      </details>

      <form class="collection-page__sort" action="{{ collection.url }}" method="get">
        {% for filter in collection.filters %}
          {% for value in filter.active_values %}
            <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
          {% endfor %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value != nil %}
              <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">
            {% endif %}
            {% if filter.max_value.value != nil %}
              <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">
            {% endif %}
          {% endif %}
        {% endfor %}
        <label for="SortBy-{{ section.id }}">{{ 'collections.collection.sort_by' | t }}</label>
        <select id="SortBy-{{ section.id }}" name="sort_by">
          {% for option in collection.sort_options %}
            <option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>
          {% endfor %}
        </select>
        <button type="submit">{{ 'collections.collection.sort' | t }}</button>
      </form>
    </div>

    {% assign has_active_filters = false %}
    {% for filter in collection.filters %}
      {% if filter.active_values.size > 0 %}{% assign has_active_filters = true %}{% endif %}
      {% if filter.type == 'price_range' and filter.min_value.value != nil or filter.type == 'price_range' and filter.max_value.value != nil %}{% assign has_active_filters = true %}{% endif %}
    {% endfor %}

    {% if has_active_filters %}
      <div class="collection-page__active-filters" aria-label="{{ 'collections.collection.active_filters' | t | escape }}">
        {% for filter in collection.filters %}
          {% for value in filter.active_values %}
            <a href="{{ value.url_to_remove }}" class="collection-page__filter-chip">
              <span>{{ value.label | escape }}</span><span aria-hidden="true">×</span>
            </a>
          {% endfor %}
          {% if filter.type == 'price_range' and filter.min_value.value != nil or filter.type == 'price_range' and filter.max_value.value != nil %}
            <a href="{{ filter.url_to_remove }}" class="collection-page__filter-chip">
              <span>{{ filter.label | escape }}</span><span aria-hidden="true">×</span>
            </a>
          {% endif %}
        {% endfor %}
        <a href="{{ collection.url }}?sort_by={{ current_sort | url_encode }}" class="collection-page__clear-all">{{ 'collections.collection.clear_all' | t }}</a>
      </div>
    {% endif %}

    {% if collection.products.size > 0 %}
      <div class="collection-page__grid">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <div class="collection-page__empty">
        <h2>{{ 'collections.collection.empty_title' | t }}</h2>
        <p>{{ 'collections.collection.empty_text' | t }}</p>
        {% if has_active_filters %}
          <a href="{{ collection.url }}" class="alchemist-button">{{ 'collections.collection.clear_filters' | t }}</a>
        {% endif %}
      </div>
    {% endif %}

    {% if paginate.pages > 1 %}
      <nav class="collection-page__pagination" aria-label="{{ 'collections.collection.pagination' | t | escape }}">
        {{ paginate | default_pagination }}
      </nav>
    {% endif %}
  {% endpaginate %}
</section>

{% stylesheet %}
  .collection-page{max-width:var(--page-width,90rem);margin:0 auto;padding:clamp(2rem,5vw,4.5rem) max(var(--page-margin,20px),1rem) 5rem}.collection-page__header{display:grid;grid-template-columns:minmax(0,1fr);gap:2rem;padding-bottom:clamp(2rem,5vw,4rem);border-bottom:1px solid var(--border-subtle)}.collection-page__header:has(.collection-page__image){grid-template-columns:minmax(0,.8fr) minmax(20rem,1.2fr);align-items:end}.collection-page__eyebrow{margin:0 0 .8rem;color:var(--accent-cyan);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase}.collection-page__heading h1{margin:0;font-size:clamp(2.6rem,7vw,6rem);line-height:.92;letter-spacing:-.05em}.collection-page__description{max-width:42rem;margin-top:1.25rem;color:var(--text-muted);line-height:1.7}.collection-page__image{overflow:hidden;border:1px solid var(--border-subtle);background:rgba(255,255,255,.025);aspect-ratio:16/9}.collection-page__image img{width:100%;height:100%;object-fit:cover}.collection-page__toolbar{display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center;padding:1.2rem 0;border-bottom:1px solid var(--border-subtle)}.collection-page__count{margin:0;color:var(--text-muted);font-size:.8rem}.collection-page__filters-drawer{position:relative;justify-self:start}.collection-page__filter-toggle{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;padding:.6rem .85rem;border:1px solid var(--border-subtle);cursor:pointer;list-style:none}.collection-page__filter-toggle::-webkit-details-marker{display:none}.collection-page__filter-count{display:inline-grid;place-items:center;min-width:1.35rem;height:1.35rem;padding:0 .25rem;border-radius:999px;background:var(--accent-cyan);color:var(--bg-dark);font-size:.7rem}.collection-page__filter-form{position:absolute;z-index:20;top:calc(100% + .65rem);left:0;width:min(28rem,calc(100vw - 2rem));max-height:70vh;overflow:auto;padding:1rem;border:1px solid var(--border-subtle);background:var(--bg-dark);box-shadow:0 1.5rem 4rem rgba(0,0,0,.35)}.collection-page__filter-group{padding:.85rem 0;border-bottom:1px solid var(--border-subtle)}.collection-page__filter-group summary{display:flex;justify-content:space-between;gap:1rem;cursor:pointer;font-weight:600}.collection-page__filter-values{display:grid;gap:.55rem;padding-top:.8rem}.collection-page__filter-value{display:grid;grid-template-columns:auto 1fr auto;gap:.65rem;align-items:center;min-height:36px;color:var(--text-muted);cursor:pointer}.collection-page__filter-value.is-disabled{opacity:.4;cursor:not-allowed}.collection-page__filter-value small{font-size:.72rem}.collection-page__price-range{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}.collection-page__price-range label>span:first-child{display:block;margin-bottom:.4rem;color:var(--text-muted);font-size:.72rem}.collection-page__money-input{display:flex;align-items:center;gap:.35rem;border:1px solid var(--border-subtle);padding:0 .65rem}.collection-page__money-input input{min-width:0;width:100%;padding:.75rem 0;border:0;background:transparent;color:inherit}.collection-page__filter-actions{display:flex;gap:.85rem;align-items:center;padding-top:1rem}.collection-page__sort{display:flex;gap:.55rem;align-items:center}.collection-page__sort label{color:var(--text-muted);font-size:.75rem}.collection-page__sort select,.collection-page__sort button{min-height:44px;border:1px solid var(--border-subtle);background:transparent;color:inherit;padding:.55rem .75rem}.collection-page__active-filters{display:flex;flex-wrap:wrap;gap:.5rem;padding:1rem 0}.collection-page__filter-chip{display:inline-flex;align-items:center;gap:.45rem;min-height:36px;padding:.45rem .7rem;border:1px solid var(--border-subtle);color:inherit;text-decoration:none;font-size:.76rem}.collection-page__clear-all{align-self:center;color:var(--text-muted);font-size:.76rem}.collection-page__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(1rem,2vw,1.6rem);padding-top:1.5rem}.collection-page__empty{text-align:center;padding:6rem 1rem}.collection-page__empty p{color:var(--text-muted)}.collection-page__pagination{display:flex;justify-content:center;padding-top:3rem}.collection-page__pagination .page,.collection-page__pagination .next,.collection-page__pagination .prev{display:inline-flex;min-width:44px;min-height:44px;align-items:center;justify-content:center;margin:.2rem;border:1px solid var(--border-subtle)}@media(max-width:1100px){.collection-page__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:749px){.collection-page__header:has(.collection-page__image){grid-template-columns:1fr}.collection-page__toolbar{grid-template-columns:1fr 1fr}.collection-page__count{grid-column:1/-1}.collection-page__sort{justify-content:flex-end}.collection-page__sort label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.collection-page__sort button{display:none}.collection-page__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.collection-page__filter-form{position:fixed;left:1rem;right:1rem;top:15vh;width:auto;max-height:70vh}.collection-page__price-range{grid-template-columns:1fr}}@media(max-width:420px){.collection-page__grid{grid-template-columns:1fr}}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": true
    }
  ]
}
{% endschema %}
