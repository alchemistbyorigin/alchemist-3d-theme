[
  {
    "name": "theme_info",
    "theme_name": "Alchemist",
    "theme_version": "0.3.0",
    "theme_author": "Alchemist by Origin",
    "theme_documentation_url": "https://github.com/alchemistbyorigin/alchemist-3d-theme#readme",
    "theme_support_url": "https://github.com/alchemistbyorigin/alchemist-3d-theme/issues"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "label": "Body font",
        "default": "work_sans_n4"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Page background",
        "default": "#F5F2EB"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "label": "Text",
        "default": "#242520"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent",
        "default": "#66563F"
      },
      {
        "type": "color",
        "id": "dark_color",
        "label": "Dark sections",
        "default": "#171916"
      },
      {
        "type": "color",
        "id": "light_color",
        "label": "Light text",
        "default": "#F5F2EB"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1360
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "label": "Page margin",
        "min": 16,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 40
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_second_image",
        "label": "Show second image on hover",
        "default": true
      }
    ]
  },
  {
    "name": "Social links",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "Tiktok"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "Youtube"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "Twitter"
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_motion",
        "label": "Enable decorative motion",
        "default": true
      }
    ]
  }
]
