[
  {
    "name": "theme_info",
    "theme_name": "Alchemist 3D",
    "theme_version": "1.0.0",
    "theme_author": "Alchemist by Origin",
    "theme_documentation_url": "https://github.com/alchemistbyorigin/alchemist-3d-theme",
    "theme_support_url": "https://github.com/alchemistbyorigin/alchemist-3d-theme/issues"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Primary font"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 1,
        "unit": "%",
        "label": "Body text scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          { "value": "80rem", "label": "Compact" },
          { "value": "90rem", "label": "Standard" },
          { "value": "110rem", "label": "Wide" }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Page margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#07080A",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#F4F1EA",
        "label": "Text"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#66FCF1",
        "label": "Accent"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#9A9995",
        "label": "Muted text"
      }
    ]
  },
  {
    "name": "Buttons and inputs",
    "settings": [
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Button corner radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_motion",
        "label": "Enable decorative motion",
        "default": true
      }
    ]
  }
]
