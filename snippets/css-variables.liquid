{% style %}
{{ settings.type_primary_font | font_face: font_display: 'swap' }}
{{ settings.heading_font | font_face: font_display: 'swap' }}
:root {
--font-body: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
--font-heading: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
--paper: {{ settings.background_color | default: '#f5f2eb' }};
--ink: {{ settings.foreground_color | default: '#242520' }};
--accent: {{ settings.accent_color | default: '#66563f' }};
--dark: {{ settings.dark_color | default: '#171916' }};
--light: {{ settings.light_color | default: '#f5f2eb' }};
--page-width: {{ settings.page_width | default: 1360 }}px;
--gutter: clamp(20px, 4vw, {{ settings.min_page_margin | default: 40 }}px);
--line: color-mix(in srgb, var(--ink) 20%, transparent);
--font-primary--family: var(--font-body); --color-background: var(--paper); --color-foreground: var(--ink);
--page-margin: var(--gutter); --style-border-radius-inputs: 0;
--alchemist-black: var(--dark); --alchemist-white: var(--light); --alchemist-cyan: var(--light); --alchemist-muted: #bdbcb3; --alchemist-line: #55574f;
--bg-dark: var(--dark); --text-light: var(--light); --text-muted: #66665e; --border-subtle: var(--line); --accent-cyan: var(--accent);
}
{% endstyle %}
