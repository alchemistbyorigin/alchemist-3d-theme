{% doc %}
  Renders a responsive Shopify image with optional link wrapping.

  @param {image} image - Image object to render
  @param {string} [url] - Optional destination URL
  @param {string} [class] - Optional wrapper class
  @param {number} [width] - Maximum rendered source width
  @param {number} [height] - Optional fixed height
  @param {string} [crop] - Optional crop position
  @param {string} [widths] - Responsive source widths
  @param {string} [sizes] - Responsive sizes attribute
  @param {string} [loading] - lazy or eager
  @param {string} [fetchpriority] - high, low, or auto
  @param {string} [alt] - Optional alt override
{% enddoc %}

{% liquid
  assign image_width = width | default: image.width
  assign image_widths = widths | default: '375, 550, 750, 1100, 1500, 2000'
  assign image_sizes = sizes | default: '100vw'
  assign image_loading = loading | default: 'lazy'
  assign image_alt = alt | default: image.alt

  if url
    assign wrapper = 'a'
  else
    assign wrapper = 'div'
  endif
%}

<{{ wrapper }}
  class="image {{ class }}"
  {% if url %}href="{{ url }}"{% endif %}
>
  {{
    image
    | image_url: width: image_width, height: height, crop: crop
    | image_tag:
      loading: image_loading,
      fetchpriority: fetchpriority,
      widths: image_widths,
      sizes: image_sizes,
      alt: image_alt
  }}
</{{ wrapper }}>

{% stylesheet %}
  .image {
    display: block;
    position: relative;
    overflow: hidden;
    width: 100%;
    height: auto;
  }

  .image > img {
    display: block;
    width: 100%;
    height: auto;
  }
{% endstylesheet %}
