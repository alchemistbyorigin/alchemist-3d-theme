{% doc %}
  @prompt
    Create a luxury animated product cards section for a high-converting storefront. Display products in an elegant editorial grid with smooth fade-in and slide-up scroll animations staggered per card. Each card should have a premium hover effect with subtle scale, soft shadow, and a quick-view or shop-now button that appears on hover with a silky transition. Include a refined section heading with elegant typography. Card design should feel high-end: clean white space, minimal borders, product image prominently featured, price styled elegantly. Settings to control number of products shown, columns, collection source, section title, and animation speed.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-editorial-products-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:56px 24px;background:#fff;color:#333}.ai-editorial-products__inner-{{ ai_gen_id }}{max-width:1180px;margin:0 auto}.ai-editorial-products__header-{{ ai_gen_id }}{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:34px}.ai-editorial-products__eyebrow-{{ ai_gen_id }}{margin:0 0 9px;color:#6b625a;font-size:11px;letter-spacing:.18em;text-transform:uppercase}.ai-editorial-products__title-{{ ai_gen_id }}{margin:0;color:#26221f;font-size:clamp(28px,4vw,48px);font-weight:400;letter-spacing:-.025em;line-height:1.08}.ai-editorial-products__collection-link-{{ ai_gen_id }}{flex-shrink:0;color:#333;font-size:13px;letter-spacing:.08em;text-decoration:none;text-transform:uppercase;border-bottom:1px solid #333;padding-bottom:5px}.ai-editorial-products__grid-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat({{ block.settings.columns }},minmax(0,1fr));gap:30px 20px}.ai-editorial-products__card-{{ ai_gen_id }}{opacity:0;transform:translateY(24px);transition:opacity {{ block.settings.animation_speed }}ms ease,transform {{ block.settings.animation_speed }}ms ease}.ai-editorial-products__card-{{ ai_gen_id }}.is-visible{opacity:1;transform:translateY(0)}.ai-editorial-products__media-{{ ai_gen_id }}{position:relative;overflow:hidden;aspect-ratio:4/5;background:#f6f5f2}.ai-editorial-products__media-{{ ai_gen_id }} img,.ai-editorial-products__placeholder-{{ ai_gen_id }} svg{display:block;width:100%;height:100%;object-fit:cover;transition:transform 500ms ease}.ai-editorial-products__placeholder-{{ ai_gen_id }}{width:100%;height:100%;color:#b3ada5}.ai-editorial-products__card-{{ ai_gen_id }}:hover .ai-editorial-products__media-{{ ai_gen_id }} img{transform:scale(1.035)}.ai-editorial-products__action-{{ ai_gen_id }}{position:absolute;right:16px;bottom:16px;left:16px;display:block;padding:13px 16px;background:#fff;color:#26221f;font-size:12px;letter-spacing:.12em;text-align:center;text-decoration:none;text-transform:uppercase;box-shadow:0 8px 24px rgba(38,34,31,.12);opacity:0;transform:translateY(8px);transition:opacity 280ms ease,transform 280ms ease}.ai-editorial-products__card-{{ ai_gen_id }}:hover .ai-editorial-products__action-{{ ai_gen_id }},.ai-editorial-products__card-{{ ai_gen_id }}:focus-within .ai-editorial-products__action-{{ ai_gen_id }}{opacity:1;transform:translateY(0)}.ai-editorial-products__info-{{ ai_gen_id }}{display:flex;justify-content:space-between;gap:14px;padding-top:15px}.ai-editorial-products__name-{{ ai_gen_id }},.ai-editorial-products__price-{{ ai_gen_id }}{margin:0;color:#333;font-size:14px;line-height:1.4}.ai-editorial-products__name-{{ ai_gen_id }}{text-decoration:none}.ai-editorial-products__price-{{ ai_gen_id }}{color:#6b625a;white-space:nowrap}.ai-editorial-products__empty-{{ ai_gen_id }}{padding:38px 20px;border:1px solid #dedbd6;color:#6b625a;text-align:center}@media screen and (max-width:749px){.ai-editorial-products-{{ ai_gen_id }}{padding:40px 16px}.ai-editorial-products__header-{{ ai_gen_id }}{align-items:start;flex-direction:column;margin-bottom:25px}.ai-editorial-products__grid-{{ ai_gen_id }}{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 12px}.ai-editorial-products__action-{{ ai_gen_id }}{right:8px;bottom:8px;left:8px;padding:10px 8px;font-size:10px}.ai-editorial-products__info-{{ ai_gen_id }}{display:block;padding-top:10px}.ai-editorial-products__price-{{ ai_gen_id }}{margin-top:4px}}@media (prefers-reduced-motion:reduce){.ai-editorial-products__card-{{ ai_gen_id }},.ai-editorial-products__media-{{ ai_gen_id }} img,.ai-editorial-products__action-{{ ai_gen_id }}{transition:none;transform:none}}
{% endstyle %}
<editorial-products-{{ ai_gen_id }} class="ai-editorial-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-editorial-products__inner-{{ ai_gen_id }}"><div class="ai-editorial-products__header-{{ ai_gen_id }}"><div>{% if block.settings.eyebrow != blank %}<p class="ai-editorial-products__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>{% endif %}<h2 class="ai-editorial-products__title-{{ ai_gen_id }}">{{ block.settings.title | escape }}</h2></div>{% if block.settings.collection != blank %}<a class="ai-editorial-products__collection-link-{{ ai_gen_id }}" href="{{ block.settings.collection.url }}">View collection</a>{% endif %}</div>{% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}<div class="ai-editorial-products__grid-{{ ai_gen_id }}">{% for product in block.settings.collection.products limit: block.settings.product_limit %}<article class="ai-editorial-products__card-{{ ai_gen_id }}" style="transition-delay:{{ forloop.index0 | times:70 }}ms"><div class="ai-editorial-products__media-{{ ai_gen_id }}"><a href="{{ product.url }}" aria-label="View {{ product.title | escape }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="1125">{% else %}<div class="ai-editorial-products__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</a><a class="ai-editorial-products__action-{{ ai_gen_id }}" href="{{ product.url }}">Shop now</a></div><div class="ai-editorial-products__info-{{ ai_gen_id }}"><a class="ai-editorial-products__name-{{ ai_gen_id }}" href="{{ product.url }}">{{ product.title | escape }}</a><p class="ai-editorial-products__price-{{ ai_gen_id }}">{{ product.price | money }}</p></div></article>{% endfor %}</div>{% else %}<div class="ai-editorial-products__empty-{{ ai_gen_id }}">Select a collection to showcase your products.</div>{% endif %}</div></editorial-products-{{ ai_gen_id }}>
<script>(function(){class EditorialProducts{{ ai_gen_id }} extends HTMLElement{connectedCallback(){const cards=this.querySelectorAll('.ai-editorial-products__card-{{ ai_gen_id }}');if(!('IntersectionObserver'in window)||window.matchMedia('(prefers-reduced-motion: reduce)').matches){cards.forEach(card=>card.classList.add('is-visible'));return}const observer=new IntersectionObserver((entries,currentObserver)=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');currentObserver.unobserve(entry.target)}})},{threshold:.12});cards.forEach(card=>observer.observe(card))}}if(!customElements.get('editorial-products-{{ ai_gen_id }}'))customElements.define('editorial-products-{{ ai_gen_id }}',EditorialProducts{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Editorial product cards","settings":[{"type":"header","content":"Content"},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Curated selection"},{"type":"text","id":"title","label":"Title","default":"Objects of distinction"},{"type":"range","id":"product_limit","label":"Products shown","min":2,"max":12,"step":1,"default":8},{"type":"header","content":"Layout"},{"type":"select","id":"columns","label":"Columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"animation_speed","label":"Animation speed","min":200,"max":1000,"step":100,"unit":"ms","default":500}],"presets":[{"name":"Editorial product cards"}],"tag":null,"class":"editorial-product-cards"}{% endschema %}