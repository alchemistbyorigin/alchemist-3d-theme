{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glowing-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    text-align: {{ block.settings.alignment }};
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-glowing-heading-{{ ai_gen_id }}__text {
    display: inline-block;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.15;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-shadow: 0 0 0 transparent;
    animation: ai-glowing-heading-pulse-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite alternate;
  }

  .ai-glowing-heading-{{ ai_gen_id }}__text:focus-visible {
    outline: 2px solid {{ block.settings.glow_color }};
    outline-offset: 6px;
    border-radius: 2px;
  }

  @keyframes ai-glowing-heading-pulse-{{ ai_gen_id }} {
    0% { text-shadow: 0 0 2px {{ block.settings.glow_color }}, 0 0 6px {{ block.settings.glow_color }}; }
    100% { text-shadow: 0 0 5px {{ block.settings.glow_color }}, 0 0 14px {{ block.settings.glow_color }}, 0 0 28px {{ block.settings.glow_color }}; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-glowing-heading-{{ ai_gen_id }}__text {
      animation: none;
      text-shadow: 0 0 5px {{ block.settings.glow_color }};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-glowing-heading-{{ ai_gen_id }}__text { font-size: {{ block.settings.mobile_font_size }}px; }
  }
{% endstyle %}

<div class="ai-glowing-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-glowing-heading-{{ ai_gen_id }}__text" tabindex="0">{{ block.settings.heading | escape }}</h2>
</div>

{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover something brilliant" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "radio", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 20 },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Font", "default": "work_sans_n4" },
    { "type": "range", "id": "font_size", "label": "Size", "min": 20, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "mobile_font_size", "label": "Mobile size", "min": 18, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "font_weight", "label": "Weight", "min": 400, "max": 700, "step": 100, "default": 600 },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": -2, "max": 5, "step": 1, "unit": "px", "default": 0 },
    { "type": "header", "content": "Colors and glow" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#333333" },
    { "type": "color", "id": "glow_color", "label": "Glow", "default": "#6B4EFF" },
    { "type": "range", "id": "animation_speed", "label": "Glow speed", "min": 1, "max": 10, "step": 1, "unit": "s", "default": 3 }
  ],
  "presets": [{ "name": "Glowing heading" }],
  "tag": null,
  "class": "glowing-heading-block"
}
{% endschema %}