{% doc %}
  @prompt
    Create a full-width luxury sticky header that starts completely transparent over the hero section and smoothly transitions to a solid dark/opaque background on scroll. Include the store logo centered or left-aligned, a horizontal navigation menu, and a cart icon on the right. The header should have a smooth CSS transition animation when changing from transparent to solid. Style it with an elegant, minimal luxury aesthetic using refined typography and subtle hover effects on navigation links.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-header-{{ ai_gen_id }} {
    position: sticky;
    top: 0;
    z-index: 30;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.transparent_text_color }};
    background: transparent;
    transition: background-color 0.35s ease, color 0.35s ease, box-shadow 0.35s ease;
  }

  .ai-luxury-header-{{ ai_gen_id }}.is-scrolled {
    color: {{ block.settings.solid_text_color }};
    background-color: {{ block.settings.solid_background_color }};
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-luxury-header__inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: {{ block.settings.header_height }}px;
    padding: 0 5vw;
  }

  .ai-luxury-header__logo-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-self: {% if block.settings.logo_alignment == 'left' %}start{% else %}center{% endif %};
    color: inherit;
    font-family: {{ block.settings.logo_font.family }}, sans-serif;
    font-size: {{ block.settings.logo_size }}px;
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.1;
    text-decoration: none;
    text-transform: uppercase;
    grid-column: {% if block.settings.logo_alignment == 'left' %}1{% else %}2{% endif %};
  }

  .ai-luxury-header__logo-{{ ai_gen_id }} img {
    display: block;
    width: auto;
    max-width: 180px;
    max-height: 48px;
    object-fit: contain;
  }

  .ai-luxury-header__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.nav_gap }}px;
    grid-column: 2;
  }

  .ai-luxury-header__nav-{{ ai_gen_id }} a {
    position: relative;
    color: inherit;
    font-size: {{ block.settings.nav_size }}px;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ai-luxury-header__nav-{{ ai_gen_id }} a::after {
    position: absolute;
    right: 0;
    bottom: -7px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    opacity: 0.8;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s ease;
  }

  .ai-luxury-header__nav-{{ ai_gen_id }} a:hover::after,
  .ai-luxury-header__nav-{{ ai_gen_id }} a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .ai-luxury-header__cart-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 7px;
    color: inherit;
    font-size: {{ block.settings.nav_size }}px;
    text-decoration: none;
  }

  .ai-luxury-header__cart-{{ ai_gen_id }} svg { width: 22px; height: 22px; }
  .ai-luxury-header__cart-count-{{ ai_gen_id }} { font-size: 11px; letter-spacing: 0.06em; }

  @media screen and (max-width: 749px) {
    .ai-luxury-header__inner-{{ ai_gen_id }} { grid-template-columns: auto 1fr auto; min-height: 68px; padding: 0 20px; }
    .ai-luxury-header__logo-{{ ai_gen_id }} { grid-column: 1; font-size: {{ block.settings.logo_size | times: 0.8 }}px; }
    .ai-luxury-header__nav-{{ ai_gen_id }} { display: none; }
    .ai-luxury-header__cart-{{ ai_gen_id }} { grid-column: 3; }
  }
{% endstyle %}

<sticky-luxury-header-{{ ai_gen_id }} class="ai-luxury-header-{{ ai_gen_id }}" data-scroll-threshold="{{ block.settings.scroll_threshold }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-header__inner-{{ ai_gen_id }}">
    <a class="ai-luxury-header__logo-{{ ai_gen_id }}" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if block.settings.logo %}
        <img src="{{ block.settings.logo | image_url: width: 360 }}" alt="{{ block.settings.logo.alt | default: shop.name | escape }}" width="180" height="48">
      {% else %}
        {{ shop.name | escape }}
      {% endif %}
    </a>
    <nav class="ai-luxury-header__nav-{{ ai_gen_id }}" aria-label="Main navigation">
      {% for i in (1..5) %}
        {% liquid
          assign label_key = 'link_' | append: i | append: '_label'
          assign url_key = 'link_' | append: i | append: '_url'
          assign label = block.settings[label_key]
          assign url = block.settings[url_key]
        %}
        {% if label != blank and url != blank %}<a href="{{ url }}">{{ label | escape }}</a>{% endif %}
      {% endfor %}
    </nav>
    <a class="ai-luxury-header__cart-{{ ai_gen_id }}" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
      <span class="ai-luxury-header__cart-count-{{ ai_gen_id }}">{{ cart.item_count }}</span>
    </a>
  </div>
</sticky-luxury-header-{{ ai_gen_id }}>

<script>
(function() {
  class StickyLuxuryHeader{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.threshold = Number(this.dataset.scrollThreshold) || 20;
      this.update = this.update.bind(this);
      this.update();
      window.addEventListener('scroll', this.update, { passive: true });
    }
    disconnectedCallback() { window.removeEventListener('scroll', this.update); }
    update() { this.classList.toggle('is-scrolled', window.scrollY > this.threshold); }
  }
  if (!customElements.get('sticky-luxury-header-{{ ai_gen_id }}')) customElements.define('sticky-luxury-header-{{ ai_gen_id }}', StickyLuxuryHeader{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Luxury sticky header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "select", "id": "logo_alignment", "label": "Logo alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "header_height", "label": "Header height", "min": 56, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "font_picker", "id": "logo_font", "label": "Logo font", "default": "work_sans_n4" },
    { "type": "range", "id": "logo_size", "label": "Logo size", "min": 12, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "nav_size", "label": "Navigation size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "nav_gap", "label": "Navigation spacing", "min": 12, "max": 48, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "scroll_threshold", "label": "Scroll threshold", "min": 1, "max": 100, "step": 1, "unit": "px", "default": 20 },
    { "type": "header", "content": "Navigation links" },
    { "type": "text", "id": "link_1_label", "label": "Link 1", "default": "Shop" },
    { "type": "url", "id": "link_1_url", "label": "Link 1 destination" },
    { "type": "text", "id": "link_2_label", "label": "Link 2", "default": "About" },
    { "type": "url", "id": "link_2_url", "label": "Link 2 destination" },
    { "type": "text", "id": "link_3_label", "label": "Link 3", "default": "Journal" },
    { "type": "url", "id": "link_3_url", "label": "Link 3 destination" },
    { "type": "text", "id": "link_4_label", "label": "Link 4", "default": "Contact" },
    { "type": "url", "id": "link_4_url", "label": "Link 4 destination" },
    { "type": "text", "id": "link_5_label", "label": "Link 5", "default": "Collections" },
    { "type": "url", "id": "link_5_url", "label": "Link 5 destination" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "transparent_text_color", "label": "Transparent text", "default": "#FFFFFF" },
    { "type": "color", "id": "solid_background_color", "label": "Solid background", "default": "#171717" },
    { "type": "color", "id": "solid_text_color", "label": "Solid text", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Luxury sticky header" }],
  "tag": null,
  "class": "luxury-sticky-header-block"
}
{% endschema %}