{% doc %}
  @prompt
    Create a full-width transparent header section for a luxury/alchemist brand store. The header should start fully transparent overlaying the hero section, then smoothly transition to a solid dark or brand-colored background on scroll. Include: logo on the left, navigation menu in the center, cart and account icons on the right. Add a subtle entrance animation when the page loads. The header should be sticky/fixed, elegant, and work well with a premium aesthetic. Support mobile with a hamburger menu.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-luxury-header-{{ ai_gen_id }}{display:block;width:100%;position:relative;z-index:20}.ai-luxury-header-{{ ai_gen_id }}__bar{position:fixed;inset:0 0 auto;width:100%;min-height:{{ block.settings.header_height }}px;display:flex;align-items:center;background:transparent;color:{{ block.settings.overlay_text_color }};transition:background-color .35s ease,color .35s ease,box-shadow .35s ease;animation:ai-luxury-header-enter-{{ ai_gen_id }} .8s ease-out both}.ai-luxury-header-{{ ai_gen_id }}__bar.is-scrolled{background:{{ block.settings.solid_background }};color:{{ block.settings.solid_text_color }};box-shadow:0 8px 26px rgba(0,0,0,.12)}.ai-luxury-header-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:1500px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px}.ai-luxury-header-{{ ai_gen_id }}__logo{display:inline-flex;align-items:center;justify-self:start;color:inherit;text-decoration:none;letter-spacing:.16em;text-transform:uppercase;font-family:{{ block.settings.logo_font.family }};font-size:{{ block.settings.logo_size }}px}.ai-luxury-header-{{ ai_gen_id }}__logo img{display:block;width:auto;max-width:180px;max-height:48px;object-fit:contain}.ai-luxury-header-{{ ai_gen_id }}__nav{display:flex;align-items:center;justify-content:center;gap:{{ block.settings.nav_gap }}px}.ai-luxury-header-{{ ai_gen_id }}__link,.ai-luxury-header-{{ ai_gen_id }}__mobile-link{color:inherit;text-decoration:none;font-size:13px;letter-spacing:.1em;text-transform:uppercase}.ai-luxury-header-{{ ai_gen_id }}__link:hover{opacity:.65}.ai-luxury-header-{{ ai_gen_id }}__actions{justify-self:end;display:flex;align-items:center;gap:18px}.ai-luxury-header-{{ ai_gen_id }}__icon,.ai-luxury-header-{{ ai_gen_id }}__menu-button{color:inherit;display:inline-flex;align-items:center;justify-content:center;background:none;border:0;padding:5px;text-decoration:none;cursor:pointer}.ai-luxury-header-{{ ai_gen_id }}__icon svg,.ai-luxury-header-{{ ai_gen_id }}__menu-button svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.5}.ai-luxury-header-{{ ai_gen_id }}__menu-button,.ai-luxury-header-{{ ai_gen_id }}__mobile-panel{display:none}@keyframes ai-luxury-header-enter-{{ ai_gen_id }}{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:749px){.ai-luxury-header-{{ ai_gen_id }}__inner{display:flex;justify-content:space-between;width:100%;padding:0 18px}.ai-luxury-header-{{ ai_gen_id }}__nav,.ai-luxury-header-{{ ai_gen_id }}__account{display:none}.ai-luxury-header-{{ ai_gen_id }}__menu-button{display:inline-flex;order:-1}.ai-luxury-header-{{ ai_gen_id }}__mobile-panel{position:fixed;display:flex;flex-direction:column;gap:22px;inset:{{ block.settings.header_height }}px 0 auto;padding:28px 24px 34px;background:{{ block.settings.solid_background }};color:{{ block.settings.solid_text_color }};transform:translateY(-140%);transition:transform .3s ease;box-shadow:0 10px 25px rgba(0,0,0,.15)}.ai-luxury-header-{{ ai_gen_id }}__mobile-panel.is-open{transform:translateY(0)}}
{% endstyle %}
<luxury-header-{{ ai_gen_id }} class="ai-luxury-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}><header class="ai-luxury-header-{{ ai_gen_id }}__bar"><div class="ai-luxury-header-{{ ai_gen_id }}__inner"><button class="ai-luxury-header-{{ ai_gen_id }}__menu-button" type="button" aria-label="Open menu" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M3 7h18M3 12h18M3 17h18"/></svg></button><a class="ai-luxury-header-{{ ai_gen_id }}__logo" href="{{ routes.root_url }}">{% if block.settings.logo %}<img src="{{ block.settings.logo | image_url: width: 360 }}" alt="{{ shop.name | escape }}">{% else %}{{ block.settings.logo_text | escape }}{% endif %}</a><nav class="ai-luxury-header-{{ ai_gen_id }}__nav" aria-label="Main navigation">{% for i in (1..4) %}{% assign label_key = 'link_' | append: i | append: '_label' %}{% assign url_key = 'link_' | append: i | append: '_url' %}{% if block.settings[label_key] != blank %}<a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings[url_key] | default: routes.root_url }}">{{ block.settings[label_key] | escape }}</a>{% endif %}{% endfor %}</nav><div class="ai-luxury-header-{{ ai_gen_id }}__actions"><a class="ai-luxury-header-{{ ai_gen_id }}__icon ai-luxury-header-{{ ai_gen_id }}__account" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.5 3.1-5.5 7-5.5s6.2 2 7 5.5"/></svg></a><a class="ai-luxury-header-{{ ai_gen_id }}__icon" href="{{ routes.cart_url }}" aria-label="Cart"><svg viewBox="0 0 24 24"><path d="M3 5h2l2 12h11l2-8H6"/><circle cx="9" cy="20" r="1"/><circle cx="17" cy="20" r="1"/></svg></a></div></div><nav class="ai-luxury-header-{{ ai_gen_id }}__mobile-panel" aria-label="Mobile navigation">{% for i in (1..4) %}{% assign label_key = 'link_' | append: i | append: '_label' %}{% assign url_key = 'link_' | append: i | append: '_url' %}{% if block.settings[label_key] != blank %}<a class="ai-luxury-header-{{ ai_gen_id }}__mobile-link" href="{{ block.settings[url_key] | default: routes.root_url }}">{{ block.settings[label_key] | escape }}</a>{% endif %}{% endfor %}</nav></header></luxury-header-{{ ai_gen_id }}>
<script>(function(){class LuxuryHeader{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.bar=this.querySelector('.ai-luxury-header-{{ ai_gen_id }}__bar');this.button=this.querySelector('.ai-luxury-header-{{ ai_gen_id }}__menu-button');this.panel=this.querySelector('.ai-luxury-header-{{ ai_gen_id }}__mobile-panel');const update=()=>this.bar.classList.toggle('is-scrolled',window.scrollY>24);update();window.addEventListener('scroll',update,{passive:true});this.button.addEventListener('click',()=>{const open=this.panel.classList.toggle('is-open');this.button.setAttribute('aria-expanded',open);this.button.setAttribute('aria-label',open?'Close menu':'Open menu')})}}customElements.define('luxury-header-{{ ai_gen_id }}',LuxuryHeader{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Luxury transparent header","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"text","id":"logo_text","label":"Logo text","default":"Alchemist"},{"type":"font_picker","id":"logo_font","label":"Logo font","default":"serif"},{"type":"range","id":"logo_size","label":"Logo size","min":12,"max":32,"step":1,"unit":"px","default":18},{"type":"range","id":"header_height","label":"Header height","min":56,"max":110,"step":2,"unit":"px","default":78},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"nav_gap","label":"Navigation spacing","min":8,"max":48,"step":4,"unit":"px","default":24},{"type":"header","content":"Navigation"},{"type":"text","id":"link_1_label","label":"Link 1","default":"Shop"},{"type":"url","id":"link_1_url","label":"Link 1 destination"},{"type":"text","id":"link_2_label","label":"Link 2","default":"About"},{"type":"url","id":"link_2_url","label":"Link 2 destination"},{"type":"text","id":"link_3_label","label":"Link 3","default":"Journal"},{"type":"url","id":"link_3_url","label":"Link 3 destination"},{"type":"text","id":"link_4_label","label":"Link 4","default":"Contact"},{"type":"url","id":"link_4_url","label":"Link 4 destination"},{"type":"header","content":"Colors"},{"type":"color","id":"overlay_text_color","label":"Overlay text","default":"#FFFFFF"},{"type":"color","id":"solid_background","label":"Scrolled background","default":"#171515"},{"type":"color","id":"solid_text_color","label":"Scrolled text","default":"#FFFFFF"}],"presets":[{"name":"Luxury transparent header"}],"tag":null,"class":"luxury-transparent-header"}{% endschema %}